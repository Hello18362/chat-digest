# ===== 在线大模型总结（DeepSeek，推荐）=====
# 把下面两行改成你自己的值，保存为 .env（不要提交到 git）
# 然后把 settings.yaml 里的 summarizer.provider 设为 deepseek 即可。
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-chat

# ===== 兼容别名：下面任一写法也能被识别 =====
# OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://api.deepseek.com

# ===== 火山方舟 / 豆包（可选，改用豆包时填）=====
# DOUBAO_API_KEY=your_api_key_here
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_TEXT_MODEL=doubao-seed-1904

# ===== 数据源目录（本机绝对路径，属于隐私，务必放 .env 而非 settings.yaml）=====
# 指向你已经导出到本地的微信数据库目录（含 message/ contact/ 子目录）。
# 不填则回落到 chatlog HTTP 模式（http://127.0.0.1:5030）。
# WX_DECRYPTED_DIR=C:/你的路径/wxid_xxx
